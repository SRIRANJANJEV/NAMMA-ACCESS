# VaxGuard Environment Variables
# Copy this file to .env and fill in your values

# ESP32 backend server URL for live telemetry
# Leave empty to run in DEMO MODE
VITE_API_BASE_URL=

# Telegram backend URL (for forwarding alerts to Telegram)
# The backend stores bot token and chat ID — never put them in frontend code
VITE_TELEGRAM_BACKEND_URL=

# External AI API key (optional — uses local advisory mode if not set)
VITE_AI_API_KEY=
